# SM GPT Backend Server Configuration
PORT=3000
HOST=0.0.0.0

# CORS allowlist (comma-separated origins, or * for local/preview access)
CORS_ORIGIN=*

# Model configuration (Qwen3.5 0.8B Q8_0 GGUF)
MODEL_REPO=ggml-org/Qwen3.5-0.8B-GGUF
MODEL_FILE=Qwen3.5-0.8B-Q8_0.gguf
MODEL_CACHE_DIR=.cache/models
MODEL_CONTEXT_SIZE=4096
DEFAULT_MAX_TOKENS=2048

# Runtime & Generation Guard limits
THREADS=
GENERATION_TIMEOUT_MS=120000
FIRST_TOKEN_TIMEOUT_MS=45000
STALL_TIMEOUT_MS=25000
MAX_REQUEST_BODY_BYTES=131072

# Platform-injected URL (optional)
APP_URL="MY_APP_URL"
